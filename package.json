{
  "name": "mph-item-standardization-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import:material:check": "node --env-file=.env scripts/import-items.mjs --material-master --dry",
    "import:material": "node --env-file=.env scripts/import-items.mjs --material-master --resume",
    "import:check": "node --env-file=.env scripts/import-items.mjs --dry",
    "import:items": "node --env-file=.env scripts/import-items.mjs --resume",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "fflate": "^0.8.3"
  }
}
